# PDF files and fuzzing seeds are byte-exact test data: byte offsets inside them
# must not change, so Git must never convert their line endings (for example to
# CRLF on Windows).
*.pdf binary
crates/ozaru-engine/fuzz/seeds/** binary
# The font data is copied from Adobe, and the engine reads it with include_str!:
# it must be the same bytes on every system.
crates/ozaru-engine/src/fonts/data/** -text
# The texts that other readers extract, compared with the engine's: kept as
# they were written, form feeds and line ends included.
crates/ozaru-engine/tests/corpus/text/** -text
